# ========================
# EVENTS APP
# ========================
EVENTS_ENV=development
EVENTS_PORT=8080

# ========================
# DATABASE
# ========================
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=SecretPaSS
DB_NAME=eventtracker
DB_SSLMODE=disable

DATABASE_URL=postgres://postgres:SecretPaSS@localhost:5432/eventtracker?sslmode=disable

# ========================
# AUTH
# ========================
API_KEY_LENGTH=32
BCRYPT_COST=12

# ========================
# LOGGING
# ========================
LOG_LEVEL=debug

# ========================
# OPTIONAL
# ========================
MAX_EVENTS_LIMIT=100
HTTP_TIMEOUT=10