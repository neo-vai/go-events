# ========================
# EVENTS APP
# ========================
EVENTS_ENV=development
PORT=8080

# ========================
# DATABASE
# ========================
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=SecretPaSS
DB_NAME=eventtracker
DB_SSLMODE=disable

DATABASE_URL=postgres://postgres:SecretPaSS@db:5432/eventtracker?sslmode=disable
DATABASE_URL_LOCALHOST=postgres://postgres:SecretPaSS@localhost:5432/eventtracker?sslmode=disable

DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5433/eventtracker_test?sslmode=disable

# ========================
# DATABASE POOL
# ========================
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME_SEC=3600
DB_MAX_CONN_IDLE_TIME_SEC=1800

# ========================
# REDIS
# ========================
REDIS_URL=redis:6379
REDIS_PASSWORD=StrongPassw0rd
REDIS_DB=0
REDIS_MAX_RETRIES=3
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=5
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_POOL_TIMEOUT=4s
REDIS_IDLE_TIMEOUT=300s

# ========================
# AUTH
# ========================
API_KEY_LENGTH=32
BCRYPT_COST=12

JWT_SECRET=your-super-secret-key-at-least-32-chars-long
JWT_EXPIRES_HOURS=24

# ========================
# RATE LIMITING
# ========================
# Format: <requests>/<duration> (e.g., 100/1m for 100 requests per minute)
RATE_LIMIT_GLOBAL=100/1m
RATE_LIMIT_LOGIN=5/1m

# ========================
# LOGGING
# ========================
LOG_LEVEL=debug

# ========================
# PROXY / NETWORK
# ========================
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12

# ========================
# OPTIONAL
# ========================
MAX_EVENTS_LIMIT=100
HTTP_TIMEOUT=10

# ========================
# NATS
# ========================
BROKER_URL=nats://nats:4222
BROKER_SUBJECT=events
BROKER_JETSTREAM_ENABLED=false

# ========================
# SEED ADMIN ACCOUNT (optional, only for development)
# ========================
# Set these to automatically create an admin account on first run.
# If the account already exists, the startup continues normally.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123